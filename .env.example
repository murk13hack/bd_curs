# =============================================================================
# ПТТ — переменные окружения Docker Compose
# Скопируйте:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# =============================================================================

# --- PostgreSQL (контейнер db) ---
POSTGRES_DB=ptt
POSTGRES_USER=ptt
POSTGRES_PASSWORD=change_me_to_strong_password

# Часовой пояс контейнеров и БД
TZ=Europe/Moscow

# --- Публикация портов на хост ---
BACKEND_PORT=8000
FRONTEND_PORT=80

# --- Frontend (сборка Vite) ---
# В prod через nginx используйте относительный путь — прокси /api/ уже настроен
VITE_API_URL=/api/v1

# --- Backend (CORS) ---
# CSV список origin'ов. Добавьте :5173 для локальной разработки Vite
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --- Backend (опционально, docker-compose подставляет автоматически) ---
# DATABASE_URL=postgresql+asyncpg://ptt:password@db:5432/ptt
# SCHEDULER_ENABLED=true
# DEFAULT_USER_ID=1
